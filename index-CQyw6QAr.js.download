  query diskSnapshots($serverId: String!) {
    server(id: $serverId) {
      id
      disk {
        id
        name
        snapshots {
          createdAt
          instanceId
          snapshotKey
        }
      }
    }
  }
`,EX=W`
  mutation addDisk($serviceId: String!, $input: DiskInput!) {
    addDiskToServer(serviceId: $serviceId, diskInput: $input) {
      id
      disk {
        id
        name
        mountPath
        sizeGB
      }
    }
  }
`,DX=W`
  mutation deleteDisk($serviceId: String!) {
    deleteDisk(serviceId: $serviceId) {
      id
      disk {
        id
        name
        mountPath
        sizeGB
      }
    }
  }
`,OX=W`
  mutation updateDisk($serviceId: String!, $input: DiskInput!) {
    updateDisk(serviceId: $serviceId, input: $input) {
      id
      disk {
        id
        name
        mountPath
        sizeGB
      }
    }
  }
`,kX=W`
  mutation restoreDiskSnapshot(
    $diskId: String!
    $instanceId: String
    $snapshotKey: String!
  ) {
    restoreDiskSnapshot(
      diskId: $diskId
      instanceId: $instanceId
      snapshotKey: $snapshotKey
    ) {
      id
      disk {
        id
        name
        mountPath
        sizeGB
      }
    }
  }
