const render = new Render();
const sandbox = await render.experimental.sandboxes.create({
  ownerId: "${t}",
});

// Locate the sandbox in the dashboard with this ID
console.log(\`Sandbox ID: \${sandbox.id}\`);

const stream = await render.experimental.sandboxes.exec(sandbox.id, "node /app/agent.js");
for await (const event of stream) {
  if (event.type === "output") {
    process.stdout.write(event.data);
  } else {
    console.log(\`exit code: \${event.exit_code}\`);
  }
